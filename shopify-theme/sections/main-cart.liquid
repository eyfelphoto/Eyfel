<section class="py-12 bg-stone-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h1 class="text-2xl sm:text-3xl font-serif font-black text-stone-950 mb-8">
      Alışveriş Sepetiniz
    </h1>

    {%- if cart.item_count == 0 -%}
      <div class="bg-white rounded-2xl p-12 text-center border border-stone-200">
        <p class="text-stone-600 text-base font-semibold">Sepetiniz şu anda boş.</p>
        <p class="text-stone-400 text-xs mt-1">Mezar plakası modellerimizi inceleyip beğendiğiniz modeli özelleştirebilirsiniz.</p>
        <a href="/#modeller" class="mt-6 inline-block px-6 py-3 bg-stone-900 text-white rounded-xl text-xs font-bold hover:bg-amber-600 transition-colors">
          Modelleri İncele
        </a>
      </div>
    {%- else -%}
      <form action="/cart" method="post" class="space-y-6">
        <div class="bg-white rounded-2xl shadow-xs border border-stone-200 divide-y divide-stone-100 overflow-hidden">
          {%- for item in cart.items -%}
            <div class="p-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
              <div class="flex items-center gap-4">
                <div class="w-20 h-20 rounded-xl overflow-hidden bg-stone-100 border border-stone-200 shrink-0">
                  {%- if item.image -%}
                    <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title }}" class="w-full h-full object-cover">
                  {%- endif -%}
                </div>
                <div>
                  <h3 class="font-bold text-base text-stone-900">{{ item.product.title }}</h3>
                  <p class="text-xs text-stone-500">{{ item.variant.title }}</p>

                  <!-- Custom Line Item Properties -->
                  {%- for property in item.properties -%}
                    {%- unless property.last == blank -%}
                      <div class="text-xs text-stone-600 mt-1">
                        <span class="font-semibold text-amber-800">{{ property.first }}:</span> {{ property.last }}
                      </div>
                    {%- endunless -%}
                  {%- endfor -%}
                </div>
              </div>

              <div class="flex items-center justify-between sm:justify-end w-full sm:w-auto gap-6">
                <span class="font-bold text-base text-stone-900">{{ item.final_line_price | money }}</span>
                <a href="/cart/change?line={{ forloop.index }}&quantity=0" class="text-xs text-rose-600 hover:underline">
                  Kaldır
                </a>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <!-- Summary & Checkout -->
        <div class="bg-white rounded-2xl p-6 shadow-xs border border-stone-200 space-y-4">
          <div class="flex items-center justify-between text-lg font-black text-stone-950">
            <span>Toplam Tutar:</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          <p class="text-xs text-stone-500">Ücretsiz Kargo. 10 Yıl Açık Hava Solmama Garantisi dahildir.</p>

          <button
            type="submit"
            name="checkout"
            class="w-full py-4 bg-amber-600 hover:bg-amber-500 text-white font-extrabold text-base rounded-xl transition-all shadow-md"
          >
            Ödeme Adımına Geç
          </button>
        </div>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Sepet Sayfası",
  "settings": []
}
{% endschema %}
