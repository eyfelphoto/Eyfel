{%- liquid
  assign is_human = true
  if product.tags contains 'hayvan' or product.title contains 'Kedi' or product.title contains 'Köpek' or product.title contains 'Evcil' or product.title contains 'Can Dost'
    assign is_human = false
  endif

  assign current_variant = product.selected_or_first_available_variant
  assign glue_price = settings.selsil_glue_price | default: 299
-%}

<section class="main-product-section py-10 sm:py-16 bg-stone-50" data-is-human="{{ is_human }}">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      
      <!-- LEFT COLUMN: Image Showcase (Clean, No Screws, No Zoom Button) -->
      <div class="lg:col-span-6 sticky top-24">
        <div class="bg-white rounded-2xl p-4 sm:p-6 shadow-md border border-stone-200">
          <div class="relative aspect-square rounded-xl overflow-hidden bg-stone-100 flex items-center justify-center">
            {%- if product.featured_media -%}
              <img
                id="ProductMainImage"
                src="{{ product.featured_media | image_url: width: 800 }}"
                alt="{{ product.title | escape }}"
                width="800"
                height="800"
                class="w-full h-full object-cover transition-all duration-300"
              >
            {%- else -%}
              {%- if is_human -%}
                <img
                  id="ProductMainImage"
                  src="{{ 'dikdortgen_60x60_model.jpg' | asset_url }}"
                  alt="{{ product.title }}"
                  width="800"
                  height="800"
                  class="w-full h-full object-cover transition-all duration-300"
                >
              {%- else -%}
                <img
                  id="ProductMainImage"
                  src="{{ 'kedi_anma_model.jpg' | asset_url }}"
                  alt="{{ product.title }}"
                  width="800"
                  height="800"
                  class="w-full h-full object-cover transition-all duration-300"
                >
              {%- endif -%}
            {%- endif -%}

            <!-- Guarantee Badge -->
            <div class="absolute bottom-3 right-3 bg-stone-900/90 text-white text-xs font-semibold px-3 py-1.5 rounded-lg flex items-center gap-1.5 shadow-md">
              <span class="text-emerald-400">🛡️</span>
              <span>10 Yıl Solmama Garantisi</span>
            </div>

            <!-- Plate Badge -->
            <div class="absolute top-3 left-3 bg-white/95 text-stone-900 text-[11px] font-bold px-2.5 py-1 rounded-md shadow-xs border border-stone-200">
              {%- if is_human -%}
                <span class="text-amber-800">📷 60x60 Mezar Taşı Üst Alanı İçin</span>
              {%- else -%}
                <span class="text-emerald-800">🐾 Can Dostu Anma Plakası</span>
              {%- endif -%}
            </div>
          </div>

          <!-- Important Headstone Info Under Image -->
          <div class="mt-4 p-3.5 bg-amber-50/80 rounded-xl border border-amber-200 text-xs text-amber-950 flex items-start gap-2.5">
            <span class="text-base shrink-0">📌</span>
            <p class="leading-relaxed">
              {%- if is_human -%}
                <strong>Sadece Fotoğraf Baskısı Hizmeti:</strong> İsim, dua ve tarihler mermere taş ustası tarafından kazındığından, plakanız taşın üst boşluğuna mezar fotoğrafı olarak pürüzsüz yapıştırılmaktadır. Vida veya delme gerekmez.
              {%- else -%}
                <strong>Vidasız & Matkapsız Bahçe / Mezar Taşı Montajı:</strong> Can dostunuz için pürüzsüz yüzeyli, vidalı görüntü olmadan doğrudan dış mekan anma taşına yapışan özel plakadır.
              {%- endif -%}
            </p>
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: Product Details & Customizer Form -->
      <div class="lg:col-span-6 bg-white rounded-2xl p-6 sm:p-8 shadow-md border border-stone-200">
        <!-- Top Category & Title -->
        <div class="text-xs font-bold text-amber-700 uppercase tracking-wider mb-1">
          {%- if is_human -%}
            Mermer Mezar Baş Taşı Fotoğraf Plakası
          {%- else -%}
            Evcil Hayvan Mezar & Anma Plakası
          {%- endif -%}
        </div>

        <h1 class="text-2xl sm:text-3xl font-serif font-black text-stone-950">
          {{ product.title }}
        </h1>

        <div class="mt-3 flex items-center gap-3">
          {% render 'price', product: product, use_variant: true %}
          <span class="text-xs text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded font-bold border border-emerald-200">
            Ücretsiz Kargo
          </span>
        </div>

        <p class="text-sm text-stone-600 mt-4 leading-relaxed">
          {{ product.description | strip_html | truncate: 250 }}
        </p>

        <!-- CUSTOMIZER FORM -->
        {% form 'product', product, id: 'product-form-customizer', class: 'mt-6 space-y-6', enctype: 'multipart/form-data' %}
          <input type="hidden" name="id" value="{{ current_variant.id }}" id="ProductVariantId">

          <!-- 1. PET MODEL SHAPE SELECTOR (If pet product) -->
          {%- unless is_human -%}
            <div class="border-t border-stone-200 pt-5">
              <label class="block text-xs font-bold text-stone-900 uppercase tracking-wider mb-2">
                1. Plaka Formu Seçin:
              </label>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2" id="PetShapeOptions">
                <button
                  type="button"
                  data-shape="dikdortgen"
                  data-preview-image="{{ 'kedi_anma_model.jpg' | asset_url }}"
                  class="shape-btn active p-2.5 rounded-xl border-2 border-amber-600 bg-amber-50 text-center text-xs font-bold text-stone-900 transition-all cursor-pointer"
                >
                  <span class="block text-base mb-1">▭</span>
                  <span>Dikdörtgen</span>
                </button>
                <button
                  type="button"
                  data-shape="kare"
                  data-preview-image="{{ 'hayvan_kare_model.jpg' | asset_url }}"
                  class="shape-btn p-2.5 rounded-xl border border-stone-200 bg-stone-50 hover:border-amber-400 text-center text-xs font-bold text-stone-800 transition-all cursor-pointer"
                >
                  <span class="block text-base mb-1">◻</span>
                  <span>Kare</span>
                </button>
                <button
                  type="button"
                  data-shape="kalp"
                  data-preview-image="{{ 'hayvan_kalp_model.jpg' | asset_url }}"
                  class="shape-btn p-2.5 rounded-xl border border-stone-200 bg-stone-50 hover:border-amber-400 text-center text-xs font-bold text-stone-800 transition-all cursor-pointer"
                >
                  <span class="block text-base mb-1">♥</span>
                  <span>Kalp</span>
                </button>
                <button
                  type="button"
                  data-shape="yuvarlak"
                  data-preview-image="{{ 'hayvan_yuvarlak_model.jpg' | asset_url }}"
                  class="shape-btn p-2.5 rounded-xl border border-stone-200 bg-stone-50 hover:border-amber-400 text-center text-xs font-bold text-stone-800 transition-all cursor-pointer"
                >
                  <span class="block text-base mb-1">◯</span>
                  <span>Yuvarlak</span>
                </button>
              </div>
              <input type="hidden" name="properties[Seçilen Model Formu]" value="Dikdörtgen" id="SelectedPetShapeInput">
            </div>
          {%- endunless -%}

          <!-- 2. SIZE SELECTOR -->
          <div class="border-t border-stone-200 pt-5">
            <label class="block text-xs font-bold text-stone-900 uppercase tracking-wider mb-2">
              Ölçü Seçimi:
            </label>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
              {%- for variant in product.variants -%}
                <label class="variant-option-label relative flex flex-col p-3 rounded-xl border text-xs font-semibold cursor-pointer transition-all {% if variant.id == current_variant.id %}border-amber-600 bg-amber-50/50 text-stone-900{% else %}border-stone-200 bg-stone-50 text-stone-700 hover:border-stone-300{% endif %}">
                  <input
                    type="radio"
                    name="variant_id_radio"
                    value="{{ variant.id }}"
                    data-price="{{ variant.price | money_without_currency }}"
                    class="sr-only variant-radio"
                    {% if variant.id == current_variant.id %}checked{% endif %}
                  >
                  <span class="font-bold text-stone-900">{{ variant.title }}</span>
                  <span class="text-amber-800 font-extrabold mt-1">{{ variant.price | money }}</span>
                </label>
              {%- endfor -%}
            </div>
          </div>

          <!-- 3. PHOTO UPLOAD & COLOR PREFERENCE -->
          <div class="border-t border-stone-200 pt-5 space-y-3">
            <label class="block text-xs font-bold text-stone-900 uppercase tracking-wider">
              Baskı İçin Fotoğraf Yükleyin:
            </label>
            <div class="p-4 border-2 border-dashed border-stone-300 hover:border-amber-500 rounded-xl bg-stone-50 text-center transition-all">
              <input
                type="file"
                name="properties[Baskı Fotoğrafı Dosyası]"
                accept="image/*"
                id="CustomPhotoInput"
                class="block w-full text-xs text-stone-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-amber-600 file:text-white hover:file:bg-amber-700 cursor-pointer"
              >
              <p class="text-[11px] text-stone-500 mt-2">
                Telefonunuzdan veya bilgisayarınızdan net bir fotoğraf seçin. Uzman ekibimiz UV baskı öncesi çözünürlüğü optimize eder.
              </p>
            </div>

            <!-- Color preference -->
            <div class="flex items-center gap-4 pt-2">
              <span class="text-xs font-semibold text-stone-700">Baskı Türü:</span>
              <label class="inline-flex items-center gap-1.5 text-xs font-medium cursor-pointer">
                <input type="radio" name="properties[Baskı Rengi]" value="Canlı Renkli (Öncelikli)" checked class="accent-amber-600">
                <span>Canlı Renkli</span>
              </label>
              <label class="inline-flex items-center gap-1.5 text-xs font-medium cursor-pointer">
                <input type="radio" name="properties[Baskı Rengi]" value="Siyah-Beyaz" class="accent-amber-600">
                <span>Siyah-Beyaz</span>
              </label>
            </div>
          </div>

          <!-- 4. PET DETAILS (If pet product) -->
          {%- unless is_human -%}
            <div class="border-t border-stone-200 pt-5 space-y-3">
              <label class="block text-xs font-bold text-stone-900 uppercase tracking-wider">
                Yazı & İsim Bilgileri (Opsiyonel):
              </label>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <input
                    type="text"
                    name="properties[Can Dost Adı]"
                    placeholder="Örn: PAMUK veya ÇAKIL"
                    class="w-full px-3 py-2 text-xs rounded-xl border border-stone-300 focus:outline-none focus:ring-2 focus:ring-amber-500"
                  >
                </div>
                <div>
                  <input
                    type="text"
                    name="properties[Tarihler]"
                    placeholder="Örn: 2014 - 2024"
                    class="w-full px-3 py-2 text-xs rounded-xl border border-stone-300 focus:outline-none focus:ring-2 focus:ring-amber-500"
                  >
                </div>
              </div>
            </div>
          {%- endunless -%}

          <!-- 5. SELSIL ULTRA TACK 50ML REUSABLE SNIPPET ADDON -->
          {% render 'selsil-glue-addon' %}

          <!-- Order note for graphic designers -->
          <div>
            <label class="block text-[11px] font-semibold text-stone-700 mb-1">
              Grafik Ekibine Notunuz (Opsiyonel):
            </label>
            <textarea
              name="properties[Grafik Ekibine Not]"
              rows="2"
              placeholder="Örn: Fotoğrafın arka planını temizleyin, yüzü biraz aydınlatın..."
              class="w-full px-3 py-2 text-xs rounded-xl border border-stone-300 focus:outline-none focus:ring-2 focus:ring-amber-500"
            ></textarea>
          </div>

          <!-- SUBMIT & CTA -->
          <div class="pt-4 border-t border-stone-200 space-y-3">
            <button
              type="submit"
              name="add"
              class="w-full py-4 px-6 bg-stone-950 hover:bg-amber-600 text-white font-extrabold text-sm sm:text-base rounded-xl transition-all shadow-lg flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>Sepete Ekle & Siparişi Tamamla</span>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </button>

            <!-- Direct WhatsApp Order -->
            <a
              href="https://wa.me/{{ settings.whatsapp_number }}?text=Merhaba,%20{{ product.title | url_encode }}%20ürünü%20için%20fotoğrafımı%20gönderip%20sipariş%20vermek%20istiyorum."
              target="_blank"
              rel="noopener"
              class="w-full py-3 px-4 bg-emerald-50 hover:bg-emerald-100 text-emerald-900 border border-emerald-300 font-bold text-xs rounded-xl transition-all flex items-center justify-center gap-2 text-center"
            >
              <span>💬 Fotoğrafı WhatsApp'tan Göndererek Sipariş Verin</span>
            </a>
          </div>
        {% endform %}

        <!-- Guarantees List -->
        <div class="mt-6 pt-6 border-t border-stone-200 grid grid-cols-2 gap-3 text-xs text-stone-700">
          <div class="flex items-center gap-2">
            <span class="text-emerald-600 font-bold">✓</span>
            <span>10 Yıl Solmama Garantisi</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-600 font-bold">✓</span>
            <span>Güneş, Kar ve Su Geçirmez</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-600 font-bold">✓</span>
            <span>Vidasız Kolay Montaj</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-600 font-bold">✓</span>
            <span>Ücretsiz Kargo & Hızlı Teslimat</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ürün Detayı & Özelleştir",
  "settings": []
}
{% endschema %}
